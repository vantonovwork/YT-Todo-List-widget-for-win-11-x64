<?xml version="1.0" encoding="utf-8"?>
<!--
  Доверенные корневые сертификаты для HTTPS:
  • системные;
  • GlobalSign Root R46 — его нет в старых Android/HarmonyOS (≤ Android 12), а на нём построены
    сертификаты AlphaSSL 2025 (например, у youtrack.r-express.ru). SHA-256:
    4F:A3:12:6D:8D:3A:11:D1:C4:85:5A:4F:80:7C:BA:D6:CF:91:9D:3A:5A:88:B0:3B:EA:2C:63:72:D9:3C:40:C9;
  • установленные пользователем на устройство (корпоративные центры сертификации).
-->
<network-security-config>
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system" />
            <certificates src="@raw/globalsign_root_r46" />
            <certificates src="user" />
        </trust-anchors>
    </base-config>
</network-security-config>
